{
  "name": "windlens-uk",
  "version": "1.0.0",
  "private": true,
  "description": "UK Day-Ahead Wind Forecast and Procurement Intelligence Platform",
  "scripts": {
    "postinstall": "npm --prefix frontend install",
    "build": "npm --prefix frontend run build",
    "dev": "python scripts/dev.py",
    "dev:all": "python scripts/dev.py",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --host 127.0.0.1 --port 8000 --reload",
    "start": "python scripts/dev.py",
    "preview": "npm --prefix frontend run preview",
    "test:backend": "pytest backend/tests"
  }
}
